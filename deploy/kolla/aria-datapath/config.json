{
    "command": "start-aria-datapath",
    "config_files": [
        {
            "source": "/var/lib/kolla/config_files/aria-agent-openstack.toml",
            "dest": "/etc/aria-agent/config.toml",
            "owner": "root",
            "perm": "0600"
        }
    ],
    "permissions": [
        {
            "path": "/var/log/kolla/aria-datapath",
            "owner": "root:root",
            "recurse": true
        }
    ]
}
