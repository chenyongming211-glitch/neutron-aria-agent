  "p3_port_scoped_snapshot": {
    "phase": "runtime_enablement_config_gated",
    "runtime_enabled": true,
    "route_enabled": true,
    "capability_advertised": true,
    "python_submitter_enabled": true,
    "incremental_rpc_enabled_default": false,
    "revisionless_incremental_mode_default": "disabled",
    "revisionless_incremental_mode_scope": "experimental test-host only; production P3 remains revision-aware",
    "enablement_gate": "incremental_rpc_enabled=true with rpc_events_enabled=true, full_resync_enabled=true, and port_source=neutronclient",
    "method": "PUT",
    "path": "/api/v1/neutron/ports/{port_id}/snapshot",
    "body_scope": "single_port",
    "body_max_bytes": 1048576,
    "timeout_ms": 3000,
    "domains_rule": "only domains present in the port managed_domains list may be mutated",
    "generation_rule": "submitted host generations start at 1; pending identity is the exact generation plus desired hash; a durable ordinary partial may retry only that exact identity",
    "fallback_rule": "on missing index, stale contract, body limit, unsafe revision relation, multi-port batch, delete event, network update, or scoped submit failure, Python falls back to full resync while keeping polling recovery enabled",
    "planned_error_codes": [
      "UDS_SCHEMA_MISMATCH",
      "UDS_BODY_TOO_LARGE",
      "generation_hash_conflict",
      "stale_generation",
      "INVALID_SNAPSHOT_GENERATION",
      "snapshot_apply_in_progress",
      "snapshot_retry_not_safe",
      "PORT_SCOPE_MISMATCH",
      "PORT_IFACE_NOT_FOUND",
      "UDS_CONTRACT_DRIFT"
    ],
    "runtime_guardrails": [
      "keep incremental_rpc_enabled=false in packaged defaults",
      "keep revisionless_incremental_mode=disabled in packaged defaults",
      "require rpc_events_enabled=true, full_resync_enabled=true, and port_source=neutronclient before incremental enablement",
      "only single local newer-revision port.update events may use scoped apply",
      "multi-port batches, delete events, network updates, overflow, unknown revision, and scoped submit failures fall back to full resync",
      "do not remove full-resync recovery"
    ]
  },
  "peer_auth_policy": "filesystem_permissions_then_peercred",
  "capability_hash": "v0.9-neutron-capabilities-6",
  "counters_v1": true,
  "acl_ipv6_v1": true,
  "counters_v2": true,
  "maintenance": {
    "schema_version": 1,
    "gate_capability_advertised": false,
    "admin_socket": {
      "path": "/run/aria/aria-admin.sock",
      "mode": "0600",
      "owner": "root:root",
      "separate_from_neutron_socket": true,
      "no_follow": true,
      "parent_owner": "root:root",
      "parent_group_world_writable": false,
      "directory_fd_anchored": true
    },
    "active_writer_rule": "only a full-host snapshot with the exact maintenance_operation_id may stage",
    "readiness_rule": "maintenance bypass returns HTTP 503 with blocked/degraded transaction truth, operation identity, reason, and complete_or_repair_maintenance action",
    "writer_serialization": "normal mutations hold a shared maintenance lease through the mutation; enter, exit, abort, and recovery hold the exclusive lease through WAL and verified gate changes",
    "wal_checkpoint": "one canonical maintenance checkpoint plus at most its exact pending transition; audit history is separate",
    "audit": "bounded structured enter/get/exit/abort attempt and result events with root-only UDS authorization outcome and no policy, token, or secret",
    "compatibility": "status schemas 2-3 remain readable; schema 4 adds maintenance transaction truth",
    "phase_values": [
      "ready",
      "bypass_preparing",
      "maintenance_bypass",
      "gate_unknown",
      "verifying",
      "committed"
    ],
    "status_fields": [
      "maintenance_phase",
      "maintenance_operation_id",
      "maintenance_reason",
      "maintenance_action",
      "acl_enforcement"
    ],
    "error_codes": [
      "maintenance_invalid_request",
      "maintenance_invalid_domains",
      "maintenance_operation_mismatch",
      "maintenance_requires_full_host",
      "maintenance_operation_conflict",
      "maintenance_phase_conflict",
      "maintenance_generation_mismatch",
      "maintenance_desired_hash_mismatch",
      "maintenance_pending_generation",
      "maintenance_recovery_blocked",
      "maintenance_convergence_incomplete",
      "maintenance_gate_unknown",
      "maintenance_authority_unavailable",
      "maintenance_gate_enable_failed",
      "maintenance_gate_disable_failed",
      "maintenance_wal_corrupt",
      "maintenance_wal_intent_failed",
      "maintenance_wal_commit_failed",
      "maintenance_pending_transition_conflict",
      "maintenance_terminal_transition_pending",
      "maintenance_terminal_retry_required",
      "maintenance_operator_recovery_required"
    ],
    "state_fields": [
      "schema_version",
      "operation_id",
      "phase",
      "active_domains",
      "expected_generation",
      "expected_desired_hash",
      "applied_generation",
      "applied_desired_hash",
      "bypass_started_at_ms",
      "last_progress_at_ms",
      "last_error"
    ],
    "routes": [
      {
        "method": "POST",
        "path": "/api/v1/admin/maintenance/enter"
      },
      {
        "method": "GET",
        "path": "/api/v1/admin/maintenance"
      },
      {
        "method": "POST",
        "path": "/api/v1/admin/maintenance/exit"
      },
      {
        "method": "POST",
        "path": "/api/v1/admin/maintenance/abort"
      }
    ]
  },
  "routes": [
    {
      "method": "GET",
      "path": "/readyz",
      "success_schema": {
        "http_status": 200,
        "body": "NeutronStatusV2Response",
        "overall_readiness": "ready"
      },
      "unready_schema": {
        "http_status": 503,
        "body": "NeutronStatusV2Response",
        "overall_readiness": [
          "unknown",
          "degraded",
          "blocked"
        ]
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/neutron/capabilities"
    },
    {
      "method": "GET",
      "path": "/api/v1/neutron/status"
    },
    {
      "method": "POST",
      "path": "/api/v1/neutron/snapshot/recover-pending",
      "request_schema": {
        "type": "object",
        "required": [
          "expected_pending_generation"
        ],
        "properties": {
          "expected_pending_generation": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "expected_desired_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "mode": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "rollback_to_last_applied",
              null
            ],
            "default": "rollback_to_last_applied"
          }
        }
      },
      "success_schema": {
        "http_status": 200,
        "status_values": [
          "recovered",
          "already_committed"
        ],
        "required": [
          "status",
          "recovered_generation",
          "desired_hash",
          "applied_generation",
          "applied_desired_hash",
          "authority_state",
          "wal_status"
        ],
        "nullable": [
          "desired_hash",
          "applied_desired_hash"
        ]
      },
      "error_schema": {
        "required": [
          "error",
          "details"
        ],
        "status_by_code": {
          "unsupported_pending_recovery_mode": 400,
          "no_applied_snapshot_to_restore": 409,
          "pending_snapshot_still_active": 409,
          "no_pending_snapshot": 409,
          "pending_generation_mismatch": 409,
          "pending_desired_hash_mismatch": 409,
          "pending_recovery_commit_failed": 500
        }
      },
      "compatibility": {
        "mode_omitted_or_null": "rollback_to_last_applied",
        "identity_guard": "generation and desired hash must match the pending snapshot",
        "already_committed": "a newer valid WAL commit refreshes runtime without rollback",
        "versioning": "contract inventory correction; API and contract versions unchanged"
      }
    },
    {
      "method": "PUT",
      "path": "/api/v1/neutron/snapshot",
      "request_schema_extension": {
        "maintenance_operation_id": {
          "type": [
            "string",
            "null"
          ],
          "required": false,
          "maxLength": 128
        }
      }
    },
    {
      "method": "PUT",
      "path": "/api/v1/neutron/ports/{port_id}/snapshot"
    },
    {
      "method": "DELETE",
      "path": "/api/v1/neutron/ports/{port_id}"
    }
  ],
  "phase_status": {
    "capabilities_metadata": "implemented",
    "python_client_validation": "implemented",
    "uds_body_limit": "implemented",
    "tcp_openapi_exclusion_test": "implemented",
    "peercred_enforcement": "implemented_config_gated",
    "peercred_audit": "implemented_connection_level",
    "socket_group_alignment": "implemented"
  }
}
