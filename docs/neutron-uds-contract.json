            "default": "rollback_to_last_applied"
          }
        }
      },
      "success_schema": {
        "http_status": 200,
        "status_values": [
          "recovered",
          "already_committed"
        ],
        "required": [
          "status",
          "recovered_generation",
          "desired_hash",
          "applied_generation",
          "applied_desired_hash",
          "authority_state",
          "wal_status"
        ],
        "nullable": [
